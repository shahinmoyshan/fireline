{
    "name": "fireline",
    "version": "2.0.0",
    "description": "An Alpine.js plugin for dynamic client-side routing, form handling, server-side rendering, and global state management.",
    "keywords": [
        "Alpine JS",
        "Alpine JS Plugin",
        "router",
        "history",
        "pushstate",
        "fireline",
        "fireline.js",
        "livewire"
    ],
    "license": "MIT",
    "module": "dist/module.esm.js",
    "unpkg": "dist/cdn.min.js",
    "scripts": {
        "build": "node scripts/build.js",
        "test": "node --test tests/*.test.cjs",
        "test:browser": "npm run build && node tests/browser.cjs",
        "test:integration": "npm run build && node tests/browser.cjs --php",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "alpinejs": "^3.15.0",
        "esbuild": "^0.21.5",
        "jsdom": "^26.1.0"
    },
    "files": [
        "dist",
        "src",
        "builds",
        "scripts/build.js"
    ],
    "peerDependencies": {
        "alpinejs": "^3.15.0"
    },
    "peerDependenciesMeta": {
        "alpinejs": {
            "optional": true
        }
    }
}
